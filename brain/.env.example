# ==============================================================================
# J.A.R.V.I.S. - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para '.env' e preencha com suas próprias credenciais.
# ==============================================================================

# 1. Configuração do Cérebro de IA e Roteamento Híbrido
# Modo de Operação:
# - 'hybrid' (Padrão): Tarefas simples (IoT, Volume, Braço, Status) no modelo Local; tarefas complexas na Nuvem.
# - 'cloud_only': Todas as interações passam pelo motor potente da nuvem.
# - 'local_only': 100% offline (privacidade e autonomia total sem gastar internet).
AI_MODE=hybrid

# Provedor da Nuvem (Escolha do Usuário):
# Opções: 'gemini' (Padrão/Gratuito), 'openai' (ChatGPT), 'claude' (Anthropic)
CLOUD_AI_PROVIDER=gemini

# Chaves das APIs Online:
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Modelo Local (via Ollama - https://ollama.com)
LOCAL_AI_MODEL=llama3.2
LOCAL_OLLAMA_URL=http://localhost:11434

# 2. Telegram Bot (@BotFather e @userinfobot)
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui
TELEGRAM_API_URL=https://api.telegram.org

# 3. Spotify Web API (https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=seu_spotify_client_id_aqui
SPOTIPY_CLIENT_SECRET=seu_spotify_client_secret_aqui
SPOTIPY_REDIRECT_URI=http://127.0.0.1:9090

# 4. WhatsApp (DDD padrão para formatação automática)
DEFAULT_DDD=27

# 5. Voz do Assistente (Microsoft Edge-TTS)
# Opções: pt-BR-AntonioNeural, pt-BR-FranciscaNeural, en-GB-RyanNeural
JARVIS_VOICE=pt-BR-AntonioNeural

# 6. Localização para Clima e Rotas Waze
HOME_ADDRESS=Rua Exemplo, 123, Bairro, Cidade - UF
WORK_ADDRESS=Avenida Exemplo, 500, Bairro, Cidade - UF

# 7. Notion API (https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_sua_chave_notion_aqui

# 8. Hardware Arduino (Porta Serial)
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_BAUD=115200

# 9. Casa Inteligente / IoT (Opcional - Home Assistant ou Tuya)
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=seu_token_de_acesso_longo_aqui
TUYA_ACCESS_ID=
TUYA_ACCESS_KEY=

# 10. Satélite de Mesa & Gateway Wi-Fi ESP32-S3 (Opcional - IP na rede local)
# ESP32_IP=192.168.1.150


# 11. Segurança do HUD do iPhone (gerado automaticamente no 1º start se vazio)
JARVIS_DOCK_TOKEN=
# DOCK_ENABLE_HTTP=0            # 1 = abre também a porta HTTP 8080 (token em texto puro; evite)
# DOCK_BIND=0.0.0.0             # ex.: IP do Tailscale para não escutar na LAN
# DOCK_CERT=/caminho/host.ts.net.crt   # certificado do `tailscale cert` (confiável no Safari)
# DOCK_KEY=/caminho/host.ts.net.key
# TELEGRAM_ALLOW_AUTO_REGISTER=0

# 12. Modelos / Gemini
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# OLLAMA_KEEP_ALIVE=30m
